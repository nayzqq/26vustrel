# --- Telegram ---
TELEGRAM_BOT_TOKEN=твой_токен_от_BotFather
TELEGRAM_CHAT_ID=твой_chat_id_куда_слать_алерты

# --- Reddit (СЕЙЧАС НЕДОСТУПНО для self-service, см. README) ---
# Оставь false/пусто, пока у тебя нет одобренного доступа к Reddit API
ENABLE_REDDIT=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=futures-sentiment-bot by u/твой_ник

# --- CryptoPanic (cryptopanic.com/developers) ---
CRYPTOPANIC_API_KEY=

# --- Общие настройки окна/кулдауна ---
# сколько минут назад считаем "свежими" сигналы и за какой период
# считаем изменение рыночных метрик (цена/OI)
ALERT_WINDOW_MINUTES=20
# кулдаун между алертами по одной и той же монете, минут
ALERT_COOLDOWN_MINUTES=60
# как часто (сек) крутится сбор данных
COLLECT_INTERVAL_SECONDS=300

# --- Пороги по категории "market" (биржевые данные: funding/OI/цена) ---
MARKET_MIN_SIGNALS=1
MARKET_RATIO_THRESHOLD=0.6
# на сколько % должна скакнуть цена за окно, чтобы считаться "резкой"
MARKET_PRICE_SPIKE_PCT=2.5
# на сколько % должен измениться Open Interest за окно
MARKET_OI_SPIKE_PCT=5.0
# при каком |funding rate| (в %) считаем перекос толпы экстремальным
MARKET_FUNDING_EXTREME_PCT=0.05

# --- Пороги по категории "news" (RSS + CryptoPanic) ---
NEWS_MIN_SIGNALS=5
NEWS_RATIO_THRESHOLD=0.65

# --- Пороги по категории "social" (Reddit, сейчас выключено) ---
SOCIAL_MIN_SIGNALS=5
SOCIAL_RATIO_THRESHOLD=0.65
